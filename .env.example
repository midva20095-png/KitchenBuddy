# Ключ сообщества: Управление → Настройки → Работа с API.
# Права: управление сообществом, сообщения, стена.
VK_GROUP_TOKEN=
VK_GROUP_ID=
VK_SCREEN_NAME=
VK_COMMUNITY_NAME=Кухня
BOT_NAME=Кухонный

# Ключ авторизации GigaChat (developers.sber.ru), уже в Base64.
# Можно с префиксом «Basic » или без него.
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_DAILY_LIMIT=40

# Ответы под постами и в беседах. 0 выключает.
WALL_REPLIES=1
CHAT_REPLIES=1
WALL_HOUR_LIMIT=30

# 1 — бот отвечает только подписчикам сообщества. 0 — всем.
# Если проверка ВК не ответила, бот всё равно отвечает.
SUBSCRIBERS_ONLY=1

# Похожие мастер-классы второго сообщества: файл DATA_DIR/lessons.json
# Формат — lessons.example.json. Пока файла нет, бот просто дописывает проекты.

PORT=8080
DATA_DIR=./data

# Railway подставляет сам, когда карточка Postgres соединена с KitchenBuddy.
# Адрес базы в репозиторий и в чат не кладём.
DATABASE_URL=

# Пароль страницы /admin. Придумайте свой и положите в Variables. В чат не присылайте.
ADMIN_PASSWORD=

# Ключ приложения ВК, чтобы поставить на страницу сообщества большую кнопку
# «Поиск рецептов». Сообщенческий ключ эту кнопку не ставит.
# Если переменной нет, бот работает как обычно и пишет об этом в лог.
VK_WIDGET_TOKEN=
NODE_ENV=production
