# Ключ сообщества: Управление → Настройки → Работа с API.
# Права: управление сообществом, сообщения, стена.
VK_GROUP_TOKEN=
VK_GROUP_ID=
VK_SCREEN_NAME=
VK_COMMUNITY_NAME=Кухня
BOT_NAME=Кухонный

# Ключ авторизации GigaChat (developers.sber.ru), уже в Base64.
# Можно с префиксом «Basic » или без него.
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_DAILY_LIMIT=40

# Ответы под постами и в беседах. 0 выключает.
WALL_REPLIES=1
CHAT_REPLIES=1
WALL_HOUR_LIMIT=30

PORT=8080
DATA_DIR=./data
NODE_ENV=production
